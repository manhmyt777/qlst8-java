<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<%Item8 item=(Item8)request.getAttribute("item");%><p class="eyebrow">QUẢN LÝ KHO</p><h1><%=item.getId()==0?"Thêm mặt hàng":"Sửa thông tin mặt hàng"%></h1><p class="muted">Tồn kho được thay đổi qua chứng từ nhập, bán và đặt hàng.</p><section class="panel"><form class="grid-form" method="post" action="<%=base%>/app/item-save"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=item.getId()%>"><label>Mã mặt hàng<input name="code" type="text" maxlength="50" value="<%=Html8.e(item.getCode())%>" <%=item.getId()>0?"readonly":"required"%>></label><label>Tên mặt hàng<input name="name" type="text" required maxlength="255" value="<%=Html8.e(item.getName())%>" ></label><label>Hãng sản xuất<input name="manufacturer" type="text" maxlength="255" value="<%=Html8.e(item.getManufacturer())%>" ></label><label>Giá bán (VNĐ)<input name="price" type="number" required min="0.01" step="0.01" value="<%=Html8.e(item.getPrice())%>" ></label><label>Bảo hành (tháng)<input name="warrantyPeriod" type="number" required min="0" max="1200" value="<%=Html8.e(item.getWarrantyPeriod())%>" ></label><label>Đơn vị<input name="unit" type="text" maxlength="255" value="<%=Html8.e(item.getUnit())%>" ></label><label class="wide">Thông số kỹ thuật<textarea name="specs" maxlength="500"><%=Html8.e(item.getSpecs())%></textarea></label><div class="wide"><button>Lưu thông tin</button> <a href="<%=base%>/app/items">Hủy bỏ</a></div></form></section><%if(item.getId()>0){%><form class="" method="post" action="<%=base%>/app/item-delete"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=item.getId()%>"><p class="muted">Chỉ xóa khi tồn bằng 0 và chưa có chứng từ tham chiếu.</p><button class="danger">Xóa mặt hàng</button></form><%}%>
<%@ include file="Footer8.jspf" %>
