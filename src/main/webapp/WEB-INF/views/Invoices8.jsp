<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<div class="title-row"><div><p class="eyebrow">BÁN TẠI QUẦY</p><h1>Hóa đơn bán hàng</h1></div><a class="button" href="<%=base%>/app/items">+ Lập hóa đơn</a></div><section class="panel"><table><tr><th>Mã hóa đơn</th><th>Ngày lập</th><th>Nhân viên</th><th>Thanh toán</th><th>Tổng tiền</th></tr><%for(var row:(List<Map<String,Object>>)request.getAttribute("rows")){%><tr><td><a href="<%=base%>/app/invoices?id=<%=row.get("id")%>">#<%=row.get("id")%></a></td><td><%=Html8.e(row.get("createdDate"))%></td><td><%=Html8.e(row.get("fullName"))%></td><td><%=Html8.e(row.get("paymentMethod"))%></td><td><%=Html8.money(row.get("totalAmount"))%></td></tr><%}%></table></section><%if(request.getAttribute("details")!=null){%><section class="panel"><h2>Chi tiết chứng từ #<%=Html8.e(request.getParameter("id"))%></h2><div class="table-wrap"><table><tbody><%List<Map<String,Object>> details=(List<Map<String,Object>>)request.getAttribute("details");if(!details.isEmpty()){%><tr><%for(String key:details.get(0).keySet()){%><th><%=Html8.e(Map.of("code","Mã hàng","name","Tên mặt hàng","quantity","Số lượng","price","Đơn giá","importPrice","Giá nhập","amount","Thành tiền").getOrDefault(key,key))%></th><%}%></tr><%}for(var detail:details){%><tr><%for(Object value:detail.values()){%><td><%=Html8.e(value)%></td><%}%></tr><%}%></tbody></table></div></section><%}%>
<%@ include file="Footer8.jspf" %>
