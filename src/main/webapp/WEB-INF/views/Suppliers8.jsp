<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<p class="eyebrow">ĐỐI TÁC CUNG ỨNG</p><h1>Nhà cung cấp</h1><section class="panel"><h2>Thêm nhà cung cấp</h2><form class="grid-form" method="post" action="<%=base%>/app/supplier-save"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="0"><label>Tên nhà cung cấp<input name="name" type="text" required maxlength="255"></label><label>Điện thoại<input name="phone" type="tel" maxlength="20"></label><label>Email<input name="email" type="email" maxlength="255"></label><label>Địa chỉ<input name="address" type="text" maxlength="255"></label><label>Mô tả<input name="description" type="text" maxlength="500"></label><button>Lưu mới</button></form></section><%for(var row:(List<Map<String,Object>>)request.getAttribute("rows")){%><section class="panel"><h2>#<%=row.get("id")%> · <%=Html8.e(row.get("name"))%></h2><form class="grid-form" method="post" action="<%=base%>/app/supplier-save"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><label>Tên<input name="name" type="text" value="<%=Html8.e(row.get("name"))%>" required></label><label>Điện thoại<input name="phone" type="tel" value="<%=Html8.e(row.get("phone"))%>" ></label><label>Email<input name="email" type="email" value="<%=Html8.e(row.get("email"))%>" ></label><label>Địa chỉ<input name="address" type="text" value="<%=Html8.e(row.get("address"))%>" ></label><label>Mô tả<input name="description" type="text" value="<%=Html8.e(row.get("description"))%>" ></label><button>Cập nhật</button></form><form class="" method="post" action="<%=base%>/app/supplier-delete"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><button class="danger">Xóa (chỉ khi chưa có phiếu nhập)</button></form></section><%}%>
