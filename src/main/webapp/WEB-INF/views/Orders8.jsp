<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<p class="eyebrow">ĐƠN TRỰC TUYẾN</p><h1><%=me.getRole().equals("CUSTOMER")?"Đơn hàng của bạn":"Duyệt và bàn giao đơn"%></h1><section class="panel table-wrap"><table><thead><tr><th>Mã / ngày</th><th>Khách / liên hệ</th><th>Giao hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><%for(var row:(List<Map<String,Object>>)request.getAttribute("rows")){%><tr><td><a href="<%=base%>/app/orders?id=<%=row.get("id")%>">#<%=row.get("id")%></a><small><%=Html8.e(row.get("orderDate"))%></small></td><td><%=Html8.e(row.get("fullName"))%><small><%=Html8.e(row.get("phone"))%></small></td><td><%=Html8.e(row.get("deliveryAddress"))%><small><%=Html8.e(row.get("paymentMethod"))%></small></td><td><%=Html8.money(row.get("totalAmount"))%></td><td><span class="pill"><%=Html8.e(row.get("status"))%></span></td><td><%if(me.getRole().equals("WAREHOUSE")&&!row.get("status").equals("Completed")){%><form class="stack" method="post" action="<%=base%>/app/order-advance"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=row.get("id")%>"><input type="hidden" name="status" value="<%=Html8.e(row.get("status"))%>"><%if(row.get("status").equals("Pending")){%><select name="delivery" required><option value="">Nhân viên giao hàng</option><%for(var d:(List<Map<String,Object>>)request.getAttribute("delivery")){%><option value="<%=d.get("id")%>"><%=Html8.e(d.get("fullName"))%></option><%}%></select><%}%><button class="secondary"><%=row.get("status").equals("Pending")?"Duyệt & bàn giao":row.get("status").equals("Exported")?"Xác nhận đang giao":"Xác nhận hoàn thành"%></button></form><%}%></td></tr><%}%></tbody></table></section><%if(request.getAttribute("details")!=null){%><section class="panel"><h2>Chi tiết chứng từ #<%=Html8.e(request.getParameter("id"))%></h2><div class="table-wrap"><table><tbody><%List<Map<String,Object>> details=(List<Map<String,Object>>)request.getAttribute("details");if(!details.isEmpty()){%><tr><%for(String key:details.get(0).keySet()){%><th><%=Html8.e(Map.of("code","Mã hàng","name","Tên mặt hàng","quantity","Số lượng","price","Đơn giá","importPrice","Giá nhập","amount","Thành tiền").getOrDefault(key,key))%></th><%}%></tr><%}for(var detail:details){%><tr><%for(Object value:detail.values()){%><td><%=Html8.e(value)%></td><%}%></tr><%}%></tbody></table></div></section><%}%>
<%@ include file="Footer8.jspf" %>
