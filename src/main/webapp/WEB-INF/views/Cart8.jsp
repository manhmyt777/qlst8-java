<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<%Cart8 basket=(Cart8)session.getAttribute("cart");%><p class="eyebrow"><%=me.getRole().equals("SALES")?"BÁN TẠI QUẦY":"MUA SẮM"%></p><h1><%=me.getRole().equals("SALES")?"Lập hóa đơn":"Giỏ hàng của bạn"%></h1><section class="panel table-wrap"><table><thead><tr><th>Mặt hàng</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody><%for(OrderItem8 line:basket.getLines()){%><tr><td><strong><%=Html8.e(line.getItem().getName())%></strong><small><%=Html8.e(line.getItem().getCode())%></small></td><td><%=Html8.money(line.getPrice())%></td><td><form class="inline" method="post" action="<%=base%>/app/cart-update"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=line.getItem().getId()%>"><input class="qty" type="number" name="quantity" min="1" max="100000" required value="<%=line.getQuantity()%>"><button class="secondary">Sửa</button></form></td><td><%=Html8.money(line.getPrice().multiply(java.math.BigDecimal.valueOf(line.getQuantity())))%></td><td><form class="" method="post" action="<%=base%>/app/cart-remove"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=line.getItem().getId()%>"><button class="text-button">Xóa</button></form></td></tr><%}%></tbody></table><%if(basket.getLines().isEmpty()){%><div class="empty">Giỏ hàng đang trống. <a href="<%=base%>/app/items">Chọn mặt hàng</a></div><%}%></section><div class="title-row"><a href="<%=base%>/app/items">← Tiếp tục chọn hàng</a><form class="" method="post" action="<%=base%>/app/cart-refresh"><input type="hidden" name="csrf" value="<%=csrf%>"><button class="secondary">Cập nhật giá hiện tại</button></form></div><%if(!basket.getLines().isEmpty()){%><section class="panel narrow checkout"><h2>Xác nhận giao dịch</h2><p class="price"><%=Html8.money(basket.getTotal())%></p><form class="stack" method="post" action="<%=base%>/app/checkout"><input type="hidden" name="csrf" value="<%=csrf%>"><%if(me.getRole().equals("CUSTOMER")){%><label>Địa chỉ nhận hàng<input name="deliveryAddress" type="text" required maxlength="255" value="<%=Html8.e(me.getAddress())%>"></label><p class="muted">Liên hệ: <%=Html8.e(me.getPhone())%></p><%}else{%><label>Khách hàng<select name="customer"><option value="">Khách vãng lai</option><%for(var row:(List<Map<String,Object>>)request.getAttribute("customers")){%><option value="<%=row.get("id")%>"><%=Html8.e(row.get("fullName"))%> · <%=Html8.e(row.get("phone"))%></option><%}%></select></label><%}%><label>Phương thức thanh toán<select name="paymentMethod"><option value="COD">Thanh toán khi nhận hàng</option><option value="CASH">Tiền mặt</option><option value="BANK_TRANSFER">Chuyển khoản</option></select></label><p class="muted">Chỉ ghi nhận phương thức; chưa tích hợp cổng thanh toán.</p><button><%=me.getRole().equals("SALES")?"Xác nhận lập hóa đơn":"Xác nhận đặt hàng"%></button></form></section><%}%>
<%@ include file="Footer8.jspf" %>
