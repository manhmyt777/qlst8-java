<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<p class="eyebrow">VẬN HÀNH KHO</p><h1>Nhập hàng</h1><section class="panel"><h2>Lập phiếu nhập</h2><form class="" method="post" action="<%=base%>/app/import-save"><input type="hidden" name="csrf" value="<%=csrf%>"><div class="grid-form"><label>Nhà cung cấp<select name="supplier" required><%for(var supplier:(List<Map<String,Object>>)request.getAttribute("suppliers")){%><option value="<%=supplier.get("id")%>"><%=Html8.e(supplier.get("name"))%></option><%}%></select></label><label>Ghi chú<input name="note" type="text" maxlength="500"></label></div><p class="muted">Nhập số lượng cho các mặt hàng cần nhập kho; bỏ trống các dòng còn lại.</p><div class="table-wrap"><table><tr><th>Mặt hàng</th><th>Tồn khả dụng</th><th>Số lượng nhập</th><th>Đơn giá nhập (VNĐ)</th></tr><%for(Item8 item:(List<Item8>)request.getAttribute("items")){%><tr><td><%=Html8.e(item.getCode())%> · <%=Html8.e(item.getName())%></td><td><%=item.getStockQuantity()%></td><td><input class="qty" type="number" name="qty_<%=item.getId()%>" min="0" max="100000"></td><td><input type="number" name="price_<%=item.getId()%>" min="0.01" step="0.01"></td></tr><%}%></table></div><button>Xác nhận nhập kho</button></form></section><section class="panel"><h2>Lịch sử nhập kho</h2><table><tr><th>Mã phiếu</th><th>Ngày nhập</th><th>Nhà cung cấp</th><th>Tổng giá trị</th></tr><%for(var row:(List<Map<String,Object>>)request.getAttribute("rows")){%><tr><td><a href="<%=base%>/app/imports?id=<%=row.get("id")%>">#<%=row.get("id")%></a></td><td><%=Html8.e(row.get("importDate"))%></td><td><%=Html8.e(row.get("name"))%></td><td><%=Html8.money(row.get("totalCost"))%></td></tr><%}%></table></section><%if(request.getAttribute("details")!=null){%><section class="panel"><h2>Chi tiết chứng từ #<%=Html8.e(request.getParameter("id"))%></h2><div class="table-wrap"><table><tbody><%List<Map<String,Object>> details=(List<Map<String,Object>>)request.getAttribute("details");if(!details.isEmpty()){%><tr><%for(String key:details.get(0).keySet()){%><th><%=Html8.e(Map.of("code","Mã hàng","name","Tên mặt hàng","quantity","Số lượng","price","Đơn giá","importPrice","Giá nhập","amount","Thành tiền").getOrDefault(key,key))%></th><%}%></tr><%}for(var detail:details){%><tr><%for(Object value:detail.values()){%><td><%=Html8.e(value)%></td><%}%></tr><%}%></tbody></table></div></section><%}%>
<%@ include file="Footer8.jspf" %>
