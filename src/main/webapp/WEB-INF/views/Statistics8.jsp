<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<%Map<String,Object> report=(Map<String,Object>)request.getAttribute("report");%><p class="eyebrow">KINH DOANH</p><h1>Thống kê cửa hàng</h1><form class="inline panel" method="get" action="<%=base%>/app/statistics"><label>Từ ngày<input type="date" name="start" required value="<%=request.getAttribute("start")%>"></label><label>Đến ngày<input type="date" name="end" required value="<%=request.getAttribute("end")%>"></label><button>Xem thống kê</button></form><div class="metric"><span>Tổng doanh thu trong kỳ</span><strong><%=Html8.money(report.get("total"))%></strong></div><p class="hint">Doanh thu tính hóa đơn tại quầy và đơn trực tuyến hiện đã Completed, lọc theo ngày lập chứng từ. Không phải doanh thu theo ngày giao xong. Bao gồm toàn bộ ngày kết thúc.</p><section class="panel"><h2>Thống kê mặt hàng</h2><table><tr><th>Mã</th><th>Tên mặt hàng</th><th>Số lượng bán</th><th>Doanh thu</th></tr><%for(var row:(List<Map<String,Object>>)report.get("items")){%><tr><td><%=Html8.e(row.get("code"))%></td><td><%=Html8.e(row.get("name"))%></td><td><%=Html8.e(row.get("totalSold"))%></td><td><%=Html8.money(row.get("totalRevenue"))%></td></tr><%}%></table></section><section class="panel"><h2>Thống kê nhà cung cấp</h2><table><tr><th>Nhà cung cấp</th><th>Tổng lượng nhập</th><th>Tổng giá trị nhập</th></tr><%for(var row:(List<Map<String,Object>>)report.get("suppliers")){%><tr><td><%=Html8.e(row.get("name"))%></td><td><%=Html8.e(row.get("totalImportedQuantity"))%></td><td><%=Html8.money(row.get("totalImportValue"))%></td></tr><%}%></table></section>
<%@ include file="Footer8.jspf" %>
