<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,java.time.*,model.*,util.Html8" %>
<% User8 me=(User8)session.getAttribute("user");String base=request.getContextPath();String csrf=Html8.e(session.getAttribute("csrf"));String current=request.getPathInfo(); %>
<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>QLST8 · Điện máy</title><link rel="stylesheet" href="<%=base%>/assets/app.css"></head><body>
<aside><a class="brand" href="<%=base%>/app/home"><span class="logo">8</span> Điện máy<span class="small">STORE MANAGEMENT</span></a><div class="nav-label">KHÔNG GIAN LÀM VIỆC</div><nav>
<a href="<%=base%>/app/home">Tổng quan</a>
<% if(me!=null){String role=me.getRole();if(Set.of("CUSTOMER","WAREHOUSE","SALES").contains(role)){ %><a href="<%=base%>/app/items">Danh mục mặt hàng</a><% }if(Set.of("CUSTOMER","SALES").contains(role)){ %><a href="<%=base%>/app/cart"><%=role.equals("SALES")?"Lập hóa đơn":"Giỏ hàng"%></a><% }if(Set.of("CUSTOMER","WAREHOUSE").contains(role)){ %><a href="<%=base%>/app/orders">Đơn trực tuyến</a><% }if(role.equals("WAREHOUSE")){ %><a href="<%=base%>/app/imports">Nhập kho</a><a href="<%=base%>/app/suppliers">Nhà cung cấp</a><% }if(role.equals("SALES")){ %><a href="<%=base%>/app/invoices">Hóa đơn bán hàng</a><% }if(role.equals("MANAGER")){ %><a href="<%=base%>/app/statistics">Thống kê kinh doanh</a><% } %>
</nav><div class="account"><strong><%=Html8.e(me.getFullName())%></strong><small><%=Html8.e(me.getRole())%></small><form method="post" action="<%=base%>/app/logout"><input type="hidden" name="csrf" value="<%=csrf%>"><button class="secondary">Đăng xuất</button></form></div><% }else{ %></nav><% } %></aside>
<div class="workspace"><header><span>Hệ thống quản lý siêu thị điện máy</span><span class="pill">Đề 08</span></header><main>
<% Object message=session.getAttribute("flash");if(message!=null){session.removeAttribute("flash"); %><div class="notice" role="status"><%=Html8.e(message)%></div><% } %>
