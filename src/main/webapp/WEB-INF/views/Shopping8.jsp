<%@ page pageEncoding="UTF-8" %>
<%@ include file="Header8.jspf" %>
<div class="title-row"><div><p class="eyebrow">SẢN PHẨM</p><h1>Danh mục mặt hàng</h1></div><%if(me.getRole().equals("WAREHOUSE")){%><a class="button" href="<%=base%>/app/edit">+ Thêm mặt hàng</a><%}%></div>
<form class="search" method="get" action="<%=base%>/app/items"><input name="keyword" placeholder="Tìm theo tên mặt hàng…" value="<%=Html8.e(request.getParameter("keyword"))%>"><button>Tìm kiếm</button></form>
<div class="products"><%for(Item8 item:(List<Item8>)request.getAttribute("items")){%><article class="product"><div class="product-art"><span><%=Html8.e(item.getManufacturer())%></span><strong><%=Html8.e(item.getCode())%></strong></div><div class="product-body"><small><%=Html8.e(item.getManufacturer())%> · <%=item.getWarrantyPeriod()%> tháng bảo hành</small><h2><%=Html8.e(item.getName())%></h2><strong class="price"><%=Html8.money(item.getPrice())%></strong><p class="muted">Khả dụng: <%=item.getStockQuantity()%> <%=Html8.e(item.getUnit())%></p><a class="button secondary" href="<%=base%>/app/item?id=<%=item.getId()%>">Xem chi tiết</a><%if(me.getRole().equals("WAREHOUSE")){%><a href="<%=base%>/app/edit?id=<%=item.getId()%>">Sửa thông tin</a><%}%></div></article><%}%></div><%if(((List<?>)request.getAttribute("items")).isEmpty()){%><div class="empty">Không có mặt hàng phù hợp.</div><%}%>
<%@ include file="Footer8.jspf" %>
